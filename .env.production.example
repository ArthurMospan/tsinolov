# Telegram bot token from @BotFather
BOT_TOKEN=replace_me

# The public HTTPS address of the deployed app. It must match SITE_ADDRESS.
WEBAPP_URL=https://replace_me
SITE_ADDRESS=replace_me

# Persistent remote SQLite-compatible database (Turso/libSQL).
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace_me

# Optional Nominatim-compatible endpoint used for explicit address searches.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org

# Used only for local fallback when Turso variables are absent.
DATABASE_PATH=/data/database.sqlite
NODE_ENV=production
